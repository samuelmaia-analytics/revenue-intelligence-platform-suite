PLATFORM_SSO_MODE=trusted_header
PLATFORM_SSO_REQUIRED_GROUPS=

# Google OAuth client from Google Cloud Console.
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=replace-with-google-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-cookie-secret

# Restrict sign-in to your Google Workspace domain.
OAUTH2_PROXY_EMAIL_DOMAINS=yourcompany.com

# Optional Google Workspace group enforcement.
# Requires Admin SDK + domain-wide delegation through a service account.
OAUTH2_PROXY_GOOGLE_ADMIN_EMAIL=admin@yourcompany.com
OAUTH2_PROXY_GOOGLE_GROUP=analytics-admins@yourcompany.com
# OAUTH2_PROXY_GOOGLE_SERVICE_ACCOUNT_JSON=/etc/oauth2-proxy/google-service-account.json
